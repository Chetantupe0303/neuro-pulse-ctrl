{
  "name": "pulse-ctrl",
  "version": "1.0.0",
  "description": "Local Wi-Fi phone trackpad and keyboard for your laptop",
  "scripts": {
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "server": "node server/index.js",
    "start:helper": "node helper/index.js",
    "helper": "node helper/index.js",
    "dev": "concurrently -k \"npm run start:server\" \"npm run start:helper\"",
    "test": "node test/end-to-end-test.js",
    "test:lifecycle": "node test/reconnect-test.js",
    "test:stage1": "node test/stage1-test.js",
    "test:stage2": "node test/stage2-test.js",
    "test:stage3": "node test/stage3-test.js",
    "test:stage4": "node test/stage4-test.js",
    "test:stage5": "node test/stage5-test.js",
    "test:stage6": "node test/stage6-test.js",
    "test:stage7": "node test/stage7-test.js",
    "test:stage8": "node test/stage8-test.js",
    "test:stage9": "node test/stage9-test.js",
    "test:stage10": "node test/stage10-test.js",
    "test:stage11": "node test/stage11-test.js",
    "test:stage12": "node test/stage12-test.js",
    "test:stage13": "node test/stage13-test.js",
    "test:stage14": "node test/stage14-test.js",
    "test:all": "node test/all-stages-test.js"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@nut-tree/nut-js": "npm:@nut-tree-fork/nut-js@^4.2.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "keywords": [
    "trackpad",
